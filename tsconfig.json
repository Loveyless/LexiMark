{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@data/*": ["data/*"]
    },
    "types": ["chrome", "node"]
  },
  "include": [
    "src/**/*",
    "entrypoints/**/*",
    "scripts/**/*",
    "wxt.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".output", ".wxt"]
}
